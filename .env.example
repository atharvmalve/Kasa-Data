# Database configuration (YugabyteDB via YSQL port 5433)
DATABASE_URL=postgresql+psycopg://yugabyte:yugabyte@127.0.0.1:5433/yugabyte

# Server configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Ingestion safeguards
MAX_FILE_SIZE_BYTES=20971520
MAX_PDF_PAGES=100

# Chunking configuration
TARGET_CHUNK_TOKENS=800
CHUNK_OVERLAP_TOKENS=100

# Local embeddings (sentence-transformers)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Optional LLM enrichment (Groq)
# If left empty, local extraction, chunking, and embeddings continue smoothly.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

